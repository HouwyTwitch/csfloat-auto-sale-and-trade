# ---------------------------------------------------------------------------
# CSFloat Auto-Sale Bot — configuration
# Copy this file to ".env" and fill in your values:  cp .env.example .env
# Docker Compose reads it automatically (env_file).
# ---------------------------------------------------------------------------

# ===== Required =====

# CSFloat API key (csfloat.com -> Profile -> Developer)
CSFLOAT_API_KEY=

# Your SteamID64 (17-digit number)
STEAM_ID64=

# Steam account login + password
STEAM_LOGIN=
STEAM_PASSWORD=

# Steam Guard secrets from your .maFile
STEAM_SHARED_SECRET=
STEAM_IDENTITY_SECRET=

# ===== Optional =====

# Steam Web API key (improves trade-offer fetching reliability)
STEAM_API_KEY=

# Proxy for CSFloat HTTP requests, e.g. socks5://user:pass@host:port
CLIENT_PROXY=

# Set to true to route Steam requests through CLIENT_PROXY as well
STEAM_USE_PROXY=false

# Polling / timing tuning (seconds) — defaults shown
NOTIF_INTERVAL_SECONDS=15
HEARTBEAT_INTERVAL_SECONDS=60
POST_RUN_DELAY_SECONDS=5
